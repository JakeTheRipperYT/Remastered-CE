<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RemasteredCE_Launcher</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <PathMap>$(MSBuildProjectDirectory)=/_/RemasteredCE</PathMap>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="publicKey" />
    <None Remove="lz4" />
    <None Remove="release" />
    <EmbeddedResource Include="publicKey" LogicalName="publicKey" />
    <EmbeddedResource Include="lz4" LogicalName="lz4" />
    <EmbeddedResource Include="release" LogicalName="release" Condition="'$(IncludeRelease)' == 'true'" />
    <ApplicationConfig Remove="RemasteredCE_Setup.exe.config" />
    <ApplicationConfig Include="RemasteredCE_Setup.exe.config" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
